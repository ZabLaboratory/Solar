{
  "name": "@zablab/solar",
  "version": "3.0.0",
  "description": "Solar â€” LSDP scene client and Vision renderer for the Zablab broadcast platform",
  "type": "module",
  "private": true,
  "main": "./dist/solar.js",
  "module": "./dist/solar.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/solar.js"
    },
    "./server": {
      "types": "./dist/server/types/server/index.d.ts",
      "import": "./dist/server/index.mjs"
    }
  },
  "files": [
    "dist",
    "scripts/patch-peer-viewer.mjs",
    "scripts/peer-viewer"
  ],
  "author": {
    "name": "Zablab",
    "email": "wellplayedprincipale@gmail.com"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:host && node scripts/build-host-html.mjs && npm run build:server && npm run check:layout",
    "build:server": "node scripts/build-server.mjs",
    "package:native": "node scripts/package-native-server.mjs",
    "check:native-package": "node scripts/check-native-package.mjs",
    "build:lib": "vite build",
    "build:host": "vite build --config vite.config.host.ts",
    "prebuild:host": "node scripts/check-vision-assets.mjs",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -b --pretty",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-peer-viewer.mjs",
    "check:layout": "node scripts/check-runtime-layout.mjs",
    "check:source-usage": "node scripts/check-source-usage.mjs",
    "check:bundle": "npm run check:layout && node scripts/check-host-bundle.mjs && node scripts/check-vision-assets.mjs",
    "prepack": "npm run check:layout",
    "native:start": "node scripts/native-lsdp-local.mjs",
    "test:native": "node scripts/test-native-lsdp.mjs",
    "check:native-client": "node scripts/check-native-client.mjs",
    "code:map": "node scripts/code/cli.mjs map",
    "code:check": "node scripts/code/cli.mjs check",
    "code:read": "node scripts/code/cli.mjs read",
    "code:find": "node scripts/code/cli.mjs find",
    "check:docs": "node scripts/check-documentation.mjs",
    "check:architecture": "npm run check:source-usage && npm run code:check && npm run check:docs && python scripts/check_file_sizes.py",
    "test:peer-install": "node scripts/test-peer-install.mjs",
    "test:architecture": "node --test tests/tooling/*.test.mjs"
  },
  "dependencies": {
    "@lumencast/canonical": "0.18.2",
    "@lumencast/protocol": "0.18.2",
    "@lumencast/runtime": "0.18.2",
    "@noble/hashes": "1.8.0",
    "fast-json-patch": "3.1.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.25.12",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "4.1.11",
    "ws": "^8.21.0"
  }
}
